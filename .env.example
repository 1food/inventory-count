# 재물조사 환경설정 예시
# 이 파일을 복사해 ".env" 로 만든 뒤 값을 채우세요. (start.bat을 처음 실행하면 자동으로 복사됩니다)
# 메모장으로 열어 "=" 뒤에 값을 적고 저장하면 됩니다. 서버를 다시 켜야 반영됩니다.

# 기관명 — 로그인 화면·브라우저 탭·화면 아래쪽에 표시됩니다.
ORG_NAME=

# 접근코드 — 직원이 앱에 들어올 때 입력하는 코드(필수, 숫자 6자리 이상).
ACCESS_CODE=

# 관리자 코드 — 관리 현황·삭제·엑셀 다운로드용(필수, 숫자 6자리 이상, 접근코드와 달라야 함).
ADMIN_CODE=

# (선택) 백업 폴더. 외장 드라이브나 NAS 경로를 적어 두면 PC 고장에도 실사 자료를 지킬 수 있습니다.
# 비우면 이 폴더 안의 backups\ 에 저장합니다. 경로는 영문으로 적어 주세요.  예) BACKUP_DIR=E:\InventoryBackup
BACKUP_DIR=

# (선택) Google Cloud Vision API 키. 있으면 서버에서 라벨을 인식하고(사용량만큼 기관에 요금 청구),
# 없으면 휴대폰 브라우저에서 인식합니다.
GOOGLE_VISION_API_KEY=

# (선택) 패스키(지문·Face ID) 관리자 로그인용 고정 HTTPS 주소. 둘 다 채워야 패스키 기능이 켜집니다.
# 예) PASSKEY_RP_ID=inventory.example.org / PASSKEY_ORIGIN=https://inventory.example.org
PASSKEY_RP_ID=
PASSKEY_ORIGIN=

# (선택) Cloudflare 고정 주소 터널 토큰. start-external.bat 에서 사용합니다.
CLOUDFLARE_TUNNEL_TOKEN=

# ── 고급(보통은 비워 두세요) ──
# 서버 포트. 같은 PC에 재물조사 서버를 두 개 둘 때만 바꿉니다(예: 체험판 8300).
V3_PORT=
# 자동 시작 작업 이름 앞부분. 같은 PC의 다른 재물조사 서버와 겹치지 않게 할 때 바꿉니다.
TASK_PREFIX=
# 체험판 모드(1이면 켬): 안내 띠·로그인 화면 코드 표시, 사진 저장 안 함, 매일 새벽 4시 이후 초기화.
DEMO_MODE=
# 체험판 안내 띠에 붙일 의견 남기기 링크(https://...).
FEEDBACK_URL=
